            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Mình vừa kiểm tra API và thấy phản hồi rất nhanh!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["issues", "{{issueId}}", "comments"]
            }
          }
        },
        {
          "name": "Get Comments (Danh sách bình luận của Issue)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["issues", "{{issueId}}", "comments"]
            }
          }
        },
        {
          "name": "Update Comment (Sửa bình luận)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Mình vừa kiểm tra lại, cần bổ sung thêm caching nhé.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["comments", "{{commentId}}"]
            }
          }
        },
        {
          "name": "Delete Comment (Xoá bình luận)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["comments", "{{commentId}}"]
            }
          }
        }
      ]
    }
  ]
}
